# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=jarcedev.com,www.jarcedev.com

# Enable only in Preview or testing environments.
CONTACT_FORM_TEST_MODE=false

# Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=JarceDev Portfolio <portfolio@firetrackcr.com>

# Private recipient. Do not publish the real value in this file.
CONTACT_TO_EMAIL=private-recipient@example.com
