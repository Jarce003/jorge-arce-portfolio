{
  "name": "jorge-arce-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:experience && next build",
    "start": "next start",
    "lint": "eslint",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:projects": "node scripts/check-projects.mjs",
    "test:demo": "node --test scripts/test-sample-demo.mjs",
    "test:world": "node --test scripts/test-world-rescue.mjs",
    "test:motion": "node --test scripts/test-world-motion.mjs",
    "build:experience": "npm --prefix experiments/r3f install --no-package-lock --no-audit --no-fund && npm --prefix experiments/r3f run build && node scripts/build-experience.mjs"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
